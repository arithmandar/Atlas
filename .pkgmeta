package-as: Atlas

manual-changelog:
    filename: Docs/ChangeLog.txt
    markup-type: plain
    
enable-nolib-creation: yes

externals:
    Libs/AceAddon-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceAddon-3.0
    Libs/AceDB-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceDB-3.0
    Libs/AceConsole-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceConsole-3.0
    Libs/AceLocale-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceLocale-3.0
    Libs/CallbackHandler-1.0: svn://svn.wowace.com/wow/callbackhandler/mainline/trunk/CallbackHandler-1.0
    Libs/LibAboutPanel: git://git.curseforge.net/wow/libaboutpanel/mainline.git
    Libs/LibBabble-Boss-3.0: svn://svn.wowace.com/wow/libbabble-boss-3-0/mainline/trunk
    Libs/LibBabble-SubZone-3.0: svn://svn.wowace.com/wow/libbabble-subzone-3-0/mainline/trunk
    Libs/LibBabble-Faction-3.0: svn://svn.wowace.com/wow/libbabble-faction-3-0/mainline/trunk
    Libs/LibDataBroker-1.1: git://git.wowace.com/wow/libdatabroker-1-1/mainline.git
    Libs/LibDBIcon-1.0: svn://svn.wowace.com/wow/libdbicon-1-0/mainline/trunk/LibDBIcon-1.0
    Libs/LibDialog-1.0: http://hg.wowace.com/wow/libdialog-1-0/mainline
    Libs/LibStub: svn://svn.wowace.com/wow/libstub/mainline/trunk
    Libs/NoTaint_UIDropDownMenu: svn://svn.wowinterface.com/NoTaint_UIDropDownMenu_Update-1134/trunk

ignore:
    - Libs/LibAboutPanel
    - Libs/LibDataBroker-1.1
    - Libs/LibDialog-1.0
    - Images/AtlasFrame-Main.psd
    - Images/AtlasFrame-BottomLeft.psd
    - Images/AtlasFrame-BottomRight.psd
    - Images/AtlasFrame-TopLeft.psd
    - Images/AtlasFrame-TopRight.psd
    - Images/AtlasFrameLarge-BottomLeft.psd
    - Images/AtlasFrameLarge-BottomRight.psd
    - Images/AtlasFrameLarge-Main.psd
    - Images/AtlasFrameLarge-MidLeft.psd
    - Images/AtlasFrameLarge-MidRight.psd
    - Images/AtlasFrameLarge-TopLeft.psd
    - Images/AtlasFrameLarge-TopRight.psd
    - Images/AtlasFrameSmall-Main.psd
    - Images/AtlasFrameSmall-TopLeft.psd
    - Images/AtlasFrameSmall-TopRight.psd
    - Images/AtlasFrameSmall-BottomRight.psd
    - Images/WorldMapIcon-Down.psd
    - Images/WorldMapIcon-Up.psd
    - Images/UI-Atlas-Icon.psd
    - Images/UI-Panel-CollapseButton-Up.psd
    - Images/UI-Panel-ExpandButton-Up.psd
    - Images/UI-WorldMap-Icon.psd
